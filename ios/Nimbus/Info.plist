<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Nimbus uncovers the map where you have actually been. Your location never leaves this device.</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>Nimbus can keep uncovering your map in the background as you travel. Your location never leaves this device.</string>
	<key>NSCameraUsageDescription</key>
	<string>Take a photo to leave a memory at this place for other people to find.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Choose a photo to leave at this place for other people to find.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Nimbus talks to the memory server running on your computer.</string>

	<!-- Background location is declared so the simulated LocationProvider can be
	     swapped for a real CLLocationManager with allowsBackgroundLocationUpdates
	     without any project changes. See LiveLocationProvider.swift. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>location</string>
	</array>

	<key>UIAppFonts</key>
	<array>
		<string>Manrope-Regular.ttf</string>
		<string>Manrope-Medium.ttf</string>
		<string>Manrope-SemiBold.ttf</string>
		<string>Manrope-Bold.ttf</string>
		<string>Manrope-ExtraBold.ttf</string>
	</array>

	<!-- The photo server runs on plain http on localhost or the LAN. This
	     exception covers exactly that and nothing wider. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
</dict>
</plist>
